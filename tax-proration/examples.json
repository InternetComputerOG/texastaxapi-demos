{
  "slug": "tax-proration",
  "formula": "seller days = Jan 1 through the closing date, inclusive (TREC 20-19 para 13, \"prorated through the Closing Date\"); seller share = round_half_up(annual * seller_days / days_in_year, cents); unpaid taxes: seller credits buyer the seller share; paid: buyer credits seller the rest",
  "rates_source": "local wrangler dev site-lane answers, 2026-11-24, tax_year 2026 (work/research/demos/discovery.md, AS3)",
  "examples": [
    {
      "name": "Fort Bend $400,000 estimate, closing 2026-06-30, taxes unpaid",
      "input": {
        "annual_tax": "7883.51",
        "closing_date": "2026-06-30",
        "taxes_paid": false
      },
      "expected": {
        "days_in_year": 365,
        "seller_days": 181,
        "seller_share": "3909.36",
        "buyer_share": "3974.15",
        "credit": {
          "to": "buyer",
          "amount": "3909.36"
        }
      }
    },
    {
      "name": "Same, closing 2026-12-15, taxes already paid",
